{%- comment -%} HHaven: long-form story text in a narrow column, with optional signature. {%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="hh-section hh-narrow">
    {%- if section.settings.heading != blank -%}<h2 style="margin:0 0 2.4rem">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte" style="font-size:1.85rem">{{ section.settings.text }}</div>
    {%- if section.settings.show_signature -%}
      <div class="hh-sig"><img src="{{ 'hh-logo-arch-cacao.svg' | asset_url }}" alt="" width="60" height="72">Holly Baynes</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HHaven story text",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "checkbox", "id": "show_signature", "label": "Show Holly's signature", "default": false }
  ],
  "presets": [ { "name": "HHaven story text" } ]
}
{% endschema %}
